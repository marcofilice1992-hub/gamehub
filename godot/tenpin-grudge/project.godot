; Engine configuration file.
config_version=5

[application]

config/name="Tenpin Grudge"
config/description="Two-player couch bowling. Ten frames, one lane, no mercy."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Pads="*res://scripts/pads.gd"
Store="*res://scripts/store.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
